# OpenSky Network credentials (register at opensky-network.org)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Polling interval in milliseconds (default: 90000)
OPENSKY_POLL_INTERVAL_MS=90000

# Server port (default: 3000)
PORT=3000

# Neon PostgreSQL database
DATABASE_URL=

# Cloudflare R2 archive for raw ADSB.lol payloads
R2_ARCHIVE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=
R2_ARCHIVE_MAX_BYTES_PER_MONTH=
R2_ARCHIVE_MAX_OBJECTS_PER_MONTH=
R2_ARCHIVE_MAX_TOTAL_BYTES=

# Shared bearer token for protected Vercel cron endpoints
CRON_SECRET=

# AWS Serverless cron alerting
AWS_REGION=eu-central-1
AWS_ENABLE_BUDGET_ALERTS=false
AWS_CRON_BUDGET_ALERT_EMAIL=
AWS_CRON_BUDGET_LIMIT_USD=1
