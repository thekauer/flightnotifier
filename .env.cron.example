# AWS deployment configuration
AWS_REGION=eu-central-1
AWS_ENABLE_BUDGET_ALERTS=false
AWS_CRON_BUDGET_ALERT_EMAIL=
AWS_CRON_BUDGET_LIMIT_USD=1

# Runtime credentials for the cron Lambdas
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
DATABASE_URL=
R2_ARCHIVE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=
R2_ARCHIVE_MAX_BYTES_PER_MONTH=
R2_ARCHIVE_MAX_BYTES_PER_DAY=
R2_ARCHIVE_MAX_OBJECT_BYTES=
R2_ARCHIVE_MAX_OBJECTS_PER_MONTH=
R2_ARCHIVE_MAX_TOTAL_BYTES=

# Deployment credentials can come from `aws configure` or be set here
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
